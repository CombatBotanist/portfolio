{
  "name": "portfolio-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "website",
    "cdk"
  ],
  "scripts": {
    "build": "npm run build --workspace=@portfolio/website && npm run build --workspace=@portfolio/cdk",
    "build:website": "npm run build --workspace=@portfolio/website",
    "build:cdk": "npm run build --workspace=@portfolio/cdk",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "npm run test --workspaces --if-present",
    "synth": "npm run build:website && npm run synth --workspace=@portfolio/cdk"
  },
  "devDependencies": {
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0"
  }
}
